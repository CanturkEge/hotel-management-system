@model ReservationDetailsDto
@{
    ViewData["Title"]="Rezervasyon detayları";
    var r=Model.Reservation;
    var nights=r.CheckOutDate.DayNumber-r.CheckInDate.DayNumber;
    var isCustomer=User.IsInRole(Roles.Customer);
}
<a class="back-link" asp-controller="@(isCustomer?"Bookings":"Staff")" asp-action="@(isCustomer?"Index":"Reservations")">← Rezervasyonlara dön</a>
<div class="section-heading"><div><p class="eyebrow">REZERVASYON · @r.Code</p><h1>@r.TypeName · Oda @r.RoomNumber</h1></div><span class="badge">@Ui.Status(r.Status)</span></div>
@if(isCustomer && (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)){<div class="detail-actions"><a class="button secondary" asp-action="Edit" asp-route-id="@r.Id">Rezervasyonu düzenle</a></div>}
<div class="detail-grid">
    <section class="panel"><p class="eyebrow">KONAKLAMA</p><h2>@Ui.Date(r.CheckInDate) — @Ui.Date(r.CheckOutDate)</h2><p>@nights gece · @r.GuestCount misafir</p><p><strong>@r.GuestName</strong><br />@r.GuestPhone</p></section>
    <section class="panel package-highlight"><p class="eyebrow">SEÇİLEN PAKET</p><h2>@r.PackageName</h2><p>@r.PackageDescription</p><p class="prewrap">@r.PackageBenefits</p></section>
    <section class="panel"><p class="eyebrow">ÜCRET AYRINTISI</p><div class="price-detail"><span>Oda · @nights gece</span><strong>@Ui.Money(r.RoomSubtotal)</strong><span>@r.PackageName · @nights gece</span><strong>@Ui.Money(r.PackageSubtotal)</strong><span>Ek hizmetler</span><strong>@Ui.Money(r.ServicesSubtotal)</strong>@if(r.DiscountAmount>0){<span>İndirim · @r.PromotionCode</span><strong>−@Ui.Money(r.DiscountAmount)</strong>}<span>Genel toplam</span><strong>@Ui.Money(r.TotalPrice)</strong></div></section>
</div>
<section class="panel reservation-extras"><div class="section-heading"><div><p class="eyebrow">EK HİZMETLER</p><h2>Konaklamanızı tamamlayın.</h2></div></div>
@if(Model.Extras.Count==0){<p class="empty">Henüz ek hizmet seçilmedi.</p>}
@foreach(var extra in Model.Extras){<div class="list-row"><span><strong>@extra.ServiceName</strong><small>@extra.Quantity adet · @Ui.Money(extra.UnitPrice)</small></span><span><strong>@Ui.Money(extra.TotalPrice)</strong>@if(isCustomer && (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed or ReservationStatus.CheckedIn)){<form asp-action="RemoveExtra" method="post"><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="extraId" value="@extra.Id" /><button class="quiet small" type="submit">Kaldır</button></form>}</span></div>}
@if(isCustomer && (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed or ReservationStatus.CheckedIn) && Model.AvailableExtras.Count>0){<form asp-action="AddExtra" method="post" class="inline-form"><input type="hidden" name="id" value="@r.Id" /><label>Hizmet<select name="extraServiceId" required>@foreach(var extra in Model.AvailableExtras){<option value="@extra.Id">@extra.Name · @Ui.Money(extra.Price)</option>}</select></label><label>Adet<input name="quantity" type="number" min="1" max="10" value="1" required /></label><button type="submit">Hizmet ekle</button></form>}
</section>
@if(isCustomer && (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)){<section class="panel promotion-box"><p class="eyebrow">KAMPANYA KODU</p>@if(string.IsNullOrEmpty(r.PromotionCode)){<form asp-action="ApplyPromotion" method="post" class="inline-form"><input type="hidden" name="id" value="@r.Id" /><label>Kod<input name="code" maxlength="30" placeholder="MERIDIAN10" required /></label><button type="submit">Kodu uygula</button></form>}else{<div class="list-row"><span><strong>@r.PromotionCode</strong><small>@Ui.Money(r.DiscountAmount) indirim uygulandı</small></span><form asp-action="RemovePromotion" method="post"><input type="hidden" name="id" value="@r.Id" /><button class="quiet small" type="submit">Kaldır</button></form></div>}</section>}
<section class="panel reservation-history"><p class="eyebrow">İŞLEM GEÇMİŞİ</p><h2>Rezervasyonda neler oldu?</h2>
@if(Model.Events.Count==0){<p class="empty">Bu eski rezervasyon için henüz işlem geçmişi bulunmuyor.</p>}
<ol class="timeline">@foreach(var item in Model.Events){<li><span class="timeline-dot"></span><div><small>@item.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @item.Actor</small><h3>@item.Title</h3><p>@item.Description</p><span class="badge">@Ui.Status(item.Status)</span></div></li>}</ol>
</section>
