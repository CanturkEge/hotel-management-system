@model List<ReservationDto>
@{ViewData["Title"]="Konaklamalarım";}
<div class="section-heading"><div><p class="eyebrow">MİSAFİR ALANI</p><h1>Konaklamalarım</h1></div><a class="button" asp-controller="Home" asp-action="Search">Yeni rezervasyon</a></div>
@if(Model.Count==0){<p class="empty">Henüz rezervasyonunuz yok. Müsait odalardan birini seçerek başlayın.</p>}
@foreach(var r in Model)
{
<article class="panel booking-card"><div class="section-heading"><div><span class="badge">@Ui.Status(r.Status)</span><h2>@r.TypeName · Oda @r.RoomNumber</h2><small class="code">Rezervasyon: @r.Code</small></div><strong>@Ui.Money(r.TotalPrice)</strong></div>
<p>@r.CheckInDate.ToString("dd.MM.yyyy") — @r.CheckOutDate.ToString("dd.MM.yyyy") · @r.GuestCount misafir · @r.GuestName</p>
@if(r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)
{<form asp-action="Cancel" method="post" data-confirm="Rezervasyon iptal edilsin mi?"><input type="hidden" name="id" value="@r.Id" /><button class="danger" type="submit">İptal talebi</button></form>}
@if(r.Status==ReservationStatus.CheckedOut && !r.HasReview)
{
<details><summary>Konaklamanı değerlendir</summary><form asp-action="Review" method="post" class="form-stack"><input type="hidden" name="ReservationId" value="@r.Id" /><label>Puan<select name="Rating"><option value="5">5 · Çok iyi</option><option value="4">4 · İyi</option><option value="3">3 · Orta</option><option value="2">2 · Kötü</option><option value="1">1 · Çok kötü</option></select></label><label>Yorum<textarea name="Comment" required minlength="5" maxlength="1500" rows="3"></textarea></label><button type="submit">Yorumu gönder</button></form></details>
}
@if(r.HasReview){<p class="muted">Bu konaklama için yorumunuz alındı. Onaylanan yorumlar oda sayfasında görünür.</p>}
</article>
}
