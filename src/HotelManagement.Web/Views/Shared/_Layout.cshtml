<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Otel") · MERIDIAN</title>
    <meta name="description" content="Meridian otel odaları, müsaitlik ve rezervasyon." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip" href="#main">İçeriğe geç</a>
<header class="site-header">
    <div class="header-shell">
    <a class="brand" asp-controller="Home" asp-action="Index">MERIDIAN<span>HOTEL & STAY</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span><span></span><span class="sr-only">Menüyü aç</span></button>
    <nav id="main-navigation" class="site-nav" aria-label="Ana gezinme">
        <a asp-controller="Home" asp-action="Index">Ana sayfa</a>
        <a asp-controller="Home" asp-action="Index" asp-fragment="odalar">Odalar</a>
        <a asp-controller="Home" asp-action="Search">Müsaitlik</a>
        <a asp-controller="Home" asp-action="News">Haberler</a>
        <a asp-controller="Home" asp-action="Contact">Bize ulaşın</a>
        @if(User.Identity?.IsAuthenticated==true)
        {
            if(User.IsInRole(Roles.Customer)) {<a asp-controller="Bookings" asp-action="Index">Konaklamalarım</a>}
            else {<a asp-controller="Staff" asp-action="Index">Personel paneli</a>}
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="quiet small" type="submit">Çıkış yap</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Müşteri girişi</a>
            <a class="button small" asp-controller="Home" asp-action="Search">Rezervasyon</a>
        }
    </nav>
    </div>
</header>
@if(User.Identity?.IsAuthenticated==true && !User.IsInRole(Roles.Customer))
{
    <nav class="staff-nav" aria-label="Personel işlemleri"><div class="staff-nav-shell">
        @if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.SuperAdmin)||User.IsInRole(Roles.Reception))
        {<a asp-controller="Staff" asp-action="Index">Genel bakış</a><a asp-controller="Staff" asp-action="Reservations">Rezervasyonlar</a>}
        @if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.SuperAdmin))
        {<a asp-controller="Content" asp-action="Index">Site içeriği</a><a asp-controller="Management" asp-action="Packages">Paketler</a><a asp-controller="Management" asp-action="Types">Oda tipleri</a><a asp-controller="Management" asp-action="Rooms">Fiziksel odalar</a><a asp-controller="Management" asp-action="Reviews">Yorumlar</a>}
        <a asp-controller="Jobs" asp-action="Index">Temizlik & bakım</a>
        @if(User.IsInRole(Roles.SuperAdmin)){<a asp-controller="Users" asp-action="Index">Hesaplar & yetkiler</a>}
    </div></nav>
}
<main id="main" class="container">
    @if(TempData["Success"] is string success){<div class="notice success" role="status"><span>@success</span><button type="button" class="notice-close" aria-label="Bildirimi kapat">×</button></div>}
    @if(TempData["Error"] is string error){<div class="notice error" role="alert"><span>@error</span><button type="button" class="notice-close" aria-label="Bildirimi kapat">×</button></div>}
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="footer-shell footer-grid">
        <div class="footer-brand"><a class="brand footer-logo" asp-controller="Home" asp-action="Index">MERIDIAN<span>HOTEL & STAY</span></a><p>Şehrin ritminin içinde, kendinize ait sakin bir alan.</p></div>
        <div><strong>Keşfedin</strong><a asp-controller="Home" asp-action="Index" asp-fragment="odalar">Odalar</a><a asp-controller="Home" asp-action="Search">Müsaitlik</a><a asp-controller="Home" asp-action="News">Haberler</a></div>
        <div><strong>Meridian</strong><a asp-controller="Home" asp-action="About">Hakkımızda</a><a asp-controller="Home" asp-action="Contact">Bize ulaşın</a><a asp-controller="Account" asp-action="StaffLogin">Personel girişi</a></div>
        <div><strong>İletişim</strong><span>Caferağa, Kadıköy · İstanbul</span><a href="tel:+902160000000">+90 216 000 00 00</a><a href="mailto:hello@meridianhotel.example">hello@meridianhotel.example</a></div>
    </div>
    <div class="footer-bottom"><span>© @DateTime.UtcNow.Year Meridian Hotel</span><span>Otel yönetimi eğitim projesi · Bilgiler temsilidir</span></div>
</footer>
</body>
</html>
