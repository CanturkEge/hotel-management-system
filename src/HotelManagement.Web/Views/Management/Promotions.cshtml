@model PromotionsPage
@{ViewData["Title"]="Kampanyalar";}
<div class="section-heading"><div><p class="eyebrow">YÖNETİM</p><h1>İndirim kodları ve kampanyalar</h1><p>Tarih, minimum gece ve kullanım limitiyle kontrollü indirim tanımlayın.</p></div></div>
<div class="split management-split"><form asp-action="SavePromotion" method="post" class="panel form-stack"><h2>@(Model.Input.Id==Guid.Empty?"Yeni kampanya":"Kampanyayı düzenle")</h2><div asp-validation-summary="All" class="validation"></div><input asp-for="Input.Id" type="hidden" /><div class="form-grid"><label>Kod<input asp-for="Input.Code" required maxlength="30" placeholder="MERIDIAN10" /></label><label>Ad<input asp-for="Input.Name" required maxlength="100" /></label></div><label>Açıklama<textarea asp-for="Input.Description" required maxlength="500" rows="3"></textarea></label><div class="form-grid"><label>İndirim türü<select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<PromotionKind>()"></select></label><label>Değer<input asp-for="Input.Value" type="number" min="0.01" step="0.01" required /></label></div><div class="form-grid"><label>Başlangıç<input asp-for="Input.StartDate" type="date" required /></label><label>Bitiş<input asp-for="Input.EndDate" type="date" required /></label></div><div class="form-grid"><label>Minimum gece<input asp-for="Input.MinimumNights" type="number" min="1" max="30" /></label><label>Kullanım limiti<input asp-for="Input.UsageLimit" type="number" min="1" placeholder="Sınırsız" /></label></div><label class="check"><input asp-for="Input.IsActive" /> Aktif</label><button type="submit">Kaydet</button>@if(Model.Input.Id!=Guid.Empty){<a asp-action="Promotions">Yeni kampanya formu</a>}</form>
<section class="panel"><h2>Kayıtlı kampanyalar</h2>@foreach(var item in Model.Items){<div class="list-row"><span><strong>@item.Code · @item.Name</strong><small>@item.StartDate.ToString("dd.MM.yyyy")–@item.EndDate.ToString("dd.MM.yyyy") · En az @item.MinimumNights gece · @item.TimesUsed/@(item.UsageLimit?.ToString()??"∞") kullanım</small></span><span><strong>@(item.Kind==PromotionKind.Percentage?$"%{item.Value:0.##}":Ui.Money(item.Value))</strong><a class="button small secondary" asp-action="Promotions" asp-route-id="@item.Id">Düzenle</a></span></div>}</section></div>
