@model RoomTypeEditorPage
@{ViewData["Title"]=Model.Input.Id==Guid.Empty?"Oda tipi ekle":"Oda tipi düzenle";}
<h1>@ViewData["Title"]</h1>
<form asp-action="EditType" method="post" enctype="multipart/form-data" class="panel form-stack">
<div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Input.Id" type="hidden" />
<label>Oda tipi adı<input asp-for="Input.Name" maxlength="100" required /></label>
<label>Açıklama<textarea asp-for="Input.Description" rows="4" maxlength="4000" required></textarea></label>
<div class="form-grid"><label>Gecelik fiyat (TRY)<input asp-for="Input.BasePrice" type="number" step="0.01" min="1" max="1000000" required /></label><label>Kapasite<input asp-for="Input.Capacity" type="number" min="1" max="20" required /></label><label>Yatak sayısı<input asp-for="Input.BedCount" type="number" min="1" max="20" required /></label><label>Alan (m²)<input asp-for="Input.SizeInSquareMeters" type="number" min="5" max="1000" required /></label></div>
<label>Olanaklar<input asp-for="Input.Amenities" maxlength="1000" placeholder="Wi-Fi, Klima, Balkon" /></label>
<fieldset class="upload-field"><legend>Oda görselleri</legend>
    @if(Model.ExistingImages.Count>0){<div class="media-manager">@foreach(var image in Model.ExistingImages){<label class="media-tile"><img src="@image.Url" alt="@image.AltText" /><span><input type="checkbox" name="RemoveImageIds" value="@image.Id" /> Bu görseli kaldır</span></label>}</div>}
    <label>Yeni görsel yükle <span class="optional">(en fazla 8 toplam)</span><input asp-for="Images" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple /></label>
    <small>JPEG, PNG, WebP veya AVIF · dosya başına en fazla 5 MB. Yeni yükleme yapınca eski bağlantı tabanlı galeri kaldırılır.</small>
</fieldset>
<div class="form-grid"><label class="check"><input asp-for="Input.IsActive" /> Satışa açık</label><label class="check"><input asp-for="Input.IsFeatured" /> Ana sayfada öne çıkar</label><label>Öne çıkan sırası<input asp-for="Input.FeaturedOrder" type="number" min="0" max="999" /></label></div>
<div class="actions"><button type="submit">Kaydet</button><a asp-action="Types">Vazgeç</a></div>
</form>
