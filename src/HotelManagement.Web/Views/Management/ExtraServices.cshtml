@model ExtraServicesPage
@{ViewData["Title"]="Ek hizmetler";}
<div class="section-heading"><div><p class="eyebrow">YÖNETİM</p><h1>Ek hizmet kataloğu</h1><p>Misafirlerin rezervasyonlarına sonradan ekleyebileceği hizmetleri yönetin.</p></div></div>
<div class="split management-split"><form asp-action="SaveExtraService" method="post" class="panel form-stack"><h2>@(Model.Input.Id==Guid.Empty?"Yeni hizmet":"Hizmeti düzenle")</h2><div asp-validation-summary="All" class="validation"></div><input asp-for="Input.Id" type="hidden" /><label>Hizmet adı<input asp-for="Input.Name" required maxlength="100" /></label><label>Açıklama<textarea asp-for="Input.Description" required maxlength="500" rows="3"></textarea></label><div class="form-grid"><label>Fiyat<input asp-for="Input.Price" type="number" min="0" step="0.01" required /></label><label>Sıra<input asp-for="Input.SortOrder" type="number" min="0" /></label></div><label class="check"><input asp-for="Input.IsActive" /> Aktif</label><button type="submit">Kaydet</button>@if(Model.Input.Id!=Guid.Empty){<a asp-action="ExtraServices">Yeni hizmet formu</a>}</form>
<section class="panel"><h2>Kayıtlı hizmetler</h2>@foreach(var item in Model.Items){<div class="list-row"><span><strong>@item.Name</strong><small>@item.Description · @(item.IsActive?"Aktif":"Pasif")</small></span><span><strong>@Ui.Money(item.Price)</strong><a class="button small secondary" asp-action="ExtraServices" asp-route-id="@item.Id">Düzenle</a></span></div>}</section></div>
