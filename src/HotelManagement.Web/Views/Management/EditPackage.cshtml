@model StayPackageInput
@{ViewData["Title"]=Model.Id==Guid.Empty?"Paket ekle":"Paketi düzenle";}
<p class="eyebrow">KONAKLAMA PAKETİ</p><h1>@ViewData["Title"]</h1>
<form asp-action="EditPackage" method="post" class="panel form-stack narrow">
<div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" />
<label>Paket adı<input asp-for="Name" maxlength="80" required placeholder="Gold" /></label>
<label>Kısa açıklama<textarea asp-for="Description" maxlength="600" rows="3" required></textarea></label>
<label>Avantajlar<textarea asp-for="Benefits" maxlength="1200" rows="6" required placeholder="Her satıra bir avantaj"></textarea></label>
<div class="form-grid"><label>Gecelik ek ücret (TRY)<input asp-for="PricePerNight" type="number" min="0" max="1000000" step="0.01" required /></label><label>Gösterim sırası<input asp-for="SortOrder" type="number" min="0" max="999" required /></label></div>
<label class="check"><input asp-for="IsActive" /> Rezervasyonda seçilebilir</label>
<div class="actions"><button type="submit">Kaydet</button><a asp-action="Packages">Vazgeç</a></div>
</form>
