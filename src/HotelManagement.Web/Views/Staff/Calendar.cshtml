@model CalendarDto
@{ViewData["Title"]="Rezervasyon takvimi";}
<div class="section-heading"><div><p class="eyebrow">RESEPSİYON</p><h1>Rezervasyon takvimi</h1><p>@Ui.Date(Model.Start) — @Ui.Date(Model.End)</p></div><div class="calendar-nav"><a class="button small secondary" asp-action="Calendar" asp-route-start="@Model.Start.AddDays(-7).ToString("yyyy-MM-dd")">← Önceki</a><a class="button small secondary" asp-action="Calendar">Bu hafta</a><a class="button small secondary" asp-action="Calendar" asp-route-start="@Model.Start.AddDays(7).ToString("yyyy-MM-dd")">Sonraki →</a></div></div>
<div class="calendar-wrap"><table class="booking-calendar"><thead><tr><th>Oda</th>@for(var i=0;i<7;i++){var day=Model.Start.AddDays(i);<th><small>@day.ToString("ddd")</small><strong>@day.ToString("dd.MM")</strong></th>}</tr></thead><tbody>@foreach(var room in Model.Rooms){<tr><th><strong>@room.RoomNumber</strong><small>@room.TypeName</small></th>@foreach(var day in room.Days){<td>@foreach(var entry in day.Entries){<a class="calendar-entry status-@((int)entry.Status)" asp-action="ReservationDetails" asp-route-id="@entry.ReservationId"><strong>@entry.GuestName</strong><small>@Ui.Status(entry.Status)</small></a>}</td>}</tr>}</tbody></table></div>
