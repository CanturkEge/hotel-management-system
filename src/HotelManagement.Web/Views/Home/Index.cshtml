@model CatalogPage
@{ViewData["Title"]="Kendinize yer açın";var today=DateOnly.FromDateTime(DateTime.Today);var home=Model.Home.Input;var hero=Model.Home.HeroImageUrl??Url.Content("~/images/room-deluxe.webp");}
<section class="hero home-hero">
    <div class="hero-copy"><p class="eyebrow">@home.HeroEyebrow</p><h1>@home.HeroTitle</h1><p>@home.HeroText</p><div class="hero-actions"><a class="button" asp-action="Search">Konaklamanızı planlayın</a><a class="text-action" href="#odalar">Odaları keşfedin ↓</a></div></div>
    <figure class="hero-media"><img src="@hero" alt="@home.HeroCaption" /><div class="hero-note"><span>GECELİK BAŞLANGIÇ</span><strong>@(Model.Types.Count>0?Ui.Money(Model.Types.Min(x=>x.BasePrice)):"Yakında")</strong><span>Doğrudan rezervasyon · Şeffaf fiyat</span></div><figcaption>@home.HeroCaption</figcaption></figure>
</section>

<form class="home-search" asp-action="Search" method="get">
    <div class="home-search-title"><span class="search-symbol" aria-hidden="true">M</span><div><small>KONAKLAMANIZ</small><strong>Tarihlerinizi seçin</strong></div></div>
    <label>Giriş<input type="date" name="start" value="@today.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")" required /></label>
    <label>Çıkış<input type="date" name="end" value="@today.AddDays(1).ToString("yyyy-MM-dd")" min="@today.AddDays(1).ToString("yyyy-MM-dd")" required /></label>
    <label>Misafir<select name="guests"><option value="1">1 misafir</option><option value="2" selected>2 misafir</option><option value="3">3 misafir</option><option value="4">4 misafir</option><option value="5">5+ misafir</option></select></label>
    <button type="submit">Müsaitliği kontrol et <span aria-hidden="true">→</span></button>
</form>

<div class="service-strip" aria-label="Rezervasyon özellikleri"><span><strong>01</strong> Anlık müsaitlik</span><span><strong>02</strong> Şeffaf toplam fiyat</span><span><strong>03</strong> Güvenli müşteri hesabı</span></div>

<section id="odalar"><div class="section-heading"><div><p class="eyebrow">@home.RoomsEyebrow</p><h2>@home.RoomsTitle</h2><p class="lead">@home.RoomsText</p></div><a class="text-action" asp-action="Search">Tarih seç ve karşılaştır →</a></div>
<div class="cards featured-rooms">
@foreach(var t in Model.Types)
{
    var photo=Ui.Images(t).FirstOrDefault();
    <article class="room-card">
        <div class="room-card-media"><img src="@(photo ?? Url.Content("~/images/room-standard.webp"))" alt="@(photo==null ? "Meridian oda görseli" : t.Name)" loading="lazy" /><span>@t.SizeInSquareMeters m²</span></div>
        <div class="card-body"><p class="eyebrow">@t.Capacity MİSAFİR · @t.BedCount YATAK</p><h3>@t.Name</h3><p class="clamp">@t.Description</p><div class="price-row"><span><small>Gecelik</small><strong>@Ui.Money(t.BasePrice)</strong></span><a class="text-action" asp-action="Details" asp-route-id="@t.Id">Odayı incele →</a></div></div>
    </article>
}
</div>
@if(Model.Types.Count==0){<p class="empty">Henüz yayınlanan oda tipi yok.</p>}
</section>

<section class="experience-section">
    <div class="experience-intro"><p class="eyebrow">@home.ExperienceEyebrow</p><h2>@home.ExperienceTitle</h2><p>@home.ExperienceText</p><a class="text-action" asp-action="About">Meridian'ı tanıyın →</a></div>
    <div class="experience-grid">
        <article><span>01</span><div><h3>@home.ExperienceOneTitle</h3><p>@home.ExperienceOneText</p></div></article>
        <article><span>02</span><div><h3>@home.ExperienceTwoTitle</h3><p>@home.ExperienceTwoText</p></div></article>
        <article><span>03</span><div><h3>@home.ExperienceThreeTitle</h3><p>@home.ExperienceThreeText</p></div></article>
    </div>
</section>

@if(Model.Reviews.Count>0)
{
<section class="reviews-section"><div class="section-heading"><div><p class="eyebrow">MİSAFİR DEFTERİ</p><h2>Konaklayanlardan.</h2></div><span class="review-score">5 üzerinden <strong>@Model.Reviews.Average(x=>x.Rating).ToString("0.0")</strong></span></div><div class="cards">
@foreach(var r in Model.Reviews.Take(3)){<article class="review editorial-review"><span class="stars" aria-label="5 üzerinden @r.Rating puan">@string.Concat(Enumerable.Repeat("★",r.Rating))</span><blockquote>“@r.Comment”</blockquote><div><strong>@r.TypeName</strong><small>Doğrulanmış konaklama</small></div></article>}
</div></section>
}

<section class="home-news"><div class="section-heading"><div><p class="eyebrow">@home.NewsEyebrow</p><h2>@home.NewsTitle</h2></div><a class="text-action" asp-action="News">Tüm haberler →</a></div><div class="news-grid compact-news">
@for(var i=0;i<Model.News.Count;i++)
{
    var article=Model.News[i];
    <article class="news-card">@if(article.CoverImageUrl!=null){<img class="news-card-image" src="@article.CoverImageUrl" alt="@article.Title" loading="lazy" />}else{<div class="news-visual news-visual-@((i%3)+1)"><span>@article.Category</span></div>}<div class="news-copy"><p class="eyebrow">@article.PublishedAt.ToString("dd.MM.yyyy")</p><h3>@article.Title</h3><p>@article.Summary</p><a class="text-action" asp-action="NewsDetail" asp-route-slug="@article.Slug">Oku →</a></div></article>
}
</div></section>

<section class="contact-banner"><div><p class="eyebrow">@home.ContactEyebrow</p><h2>@home.ContactTitle</h2><p>@home.ContactText</p></div><div class="hero-actions"><a class="button light" asp-action="Contact">Bize ulaşın</a><a class="text-action light-link" href="tel:@home.ContactPhone">@home.ContactPhone</a></div></section>
