@model HomeContentEditorPage
@{ViewData["Title"]="Ana sayfayı düzenle";}
<div class="section-heading"><div><p class="eyebrow">İÇERİK YÖNETİMİ</p><h1>Ana sayfa</h1><p class="lead">Ziyaretçinin gördüğü başlıkları, açıklamaları, iletişimi ve kapak görselini değiştirin.</p></div></div>
<form asp-action="Home" method="post" enctype="multipart/form-data" class="form-stack">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<section class="panel form-stack"><h2>Kapak alanı</h2>
    @if(Model.CurrentHeroImageUrl!=null){<img class="editor-cover" src="@Model.CurrentHeroImageUrl" alt="Mevcut kapak görseli" /><label class="check"><input asp-for="RemoveHeroImage" /> Mevcut görseli kaldır</label>}
    <label>Yeni kapak görseli<input asp-for="HeroImage" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /></label><small>JPEG, PNG, WebP veya AVIF · en fazla 5 MB.</small>
    <label>Üst başlık<input asp-for="Input.HeroEyebrow" maxlength="100" required /></label><label>Ana başlık<input asp-for="Input.HeroTitle" maxlength="180" required /></label><label>Açıklama<textarea asp-for="Input.HeroText" rows="3" maxlength="600" required></textarea></label><label>Görsel açıklaması<input asp-for="Input.HeroCaption" maxlength="160" /></label>
</section>
<section class="panel form-stack"><h2>Öne çıkan odalar alanı</h2><p class="muted">Hangi odaların çıkacağını Oda tipleri ekranındaki “Ana sayfada öne çıkar” seçeneği belirler.</p><label>Üst başlık<input asp-for="Input.RoomsEyebrow" maxlength="100" required /></label><label>Başlık<input asp-for="Input.RoomsTitle" maxlength="180" required /></label><label>Açıklama<textarea asp-for="Input.RoomsText" rows="3" maxlength="600" required></textarea></label></section>
<section class="panel form-stack"><h2>Deneyim alanı</h2><label>Üst başlık<input asp-for="Input.ExperienceEyebrow" maxlength="100" required /></label><label>Başlık<input asp-for="Input.ExperienceTitle" maxlength="180" required /></label><label>Açıklama<textarea asp-for="Input.ExperienceText" rows="3" maxlength="600" required></textarea></label>
<div class="editor-columns"><div><h3>Birinci kart</h3><label>Başlık<input asp-for="Input.ExperienceOneTitle" maxlength="100" required /></label><label>Metin<textarea asp-for="Input.ExperienceOneText" rows="3" maxlength="500" required></textarea></label></div><div><h3>İkinci kart</h3><label>Başlık<input asp-for="Input.ExperienceTwoTitle" maxlength="100" required /></label><label>Metin<textarea asp-for="Input.ExperienceTwoText" rows="3" maxlength="500" required></textarea></label></div><div><h3>Üçüncü kart</h3><label>Başlık<input asp-for="Input.ExperienceThreeTitle" maxlength="100" required /></label><label>Metin<textarea asp-for="Input.ExperienceThreeText" rows="3" maxlength="500" required></textarea></label></div></div></section>
<section class="panel form-stack"><h2>Haber ve iletişim alanı</h2><div class="form-grid"><label>Haber üst başlığı<input asp-for="Input.NewsEyebrow" maxlength="100" required /></label><label>Haber başlığı<input asp-for="Input.NewsTitle" maxlength="180" required /></label></div><label>İletişim üst başlığı<input asp-for="Input.ContactEyebrow" maxlength="100" required /></label><label>İletişim başlığı<input asp-for="Input.ContactTitle" maxlength="180" required /></label><label>İletişim metni<textarea asp-for="Input.ContactText" rows="3" maxlength="600" required></textarea></label><div class="form-grid"><label>Telefon<input asp-for="Input.ContactPhone" maxlength="30" required /></label><label>E-posta<input asp-for="Input.ContactEmail" type="email" maxlength="254" required /></label></div></section>
<div class="actions"><button type="submit">Ana sayfayı kaydet</button><a asp-action="Index">Vazgeç</a></div>
</form>
